# Frontend config. Copy to .env.local (gitignored) to override.
# Where the FastAPI backend is reachable.
VITE_API_BASE=http://localhost:8000
# Which subject the /atlas demo conversation targets by default. Any real
# USUBJID from the loaded study works; the default is one with a real finding
# so the finding-graph panel has something to show.
VITE_DEMO_SUBJECT=042-S07-001
