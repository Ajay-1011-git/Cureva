# Copy to .env (gitignored) and fill in. Never commit real keys.
GROQ_API_KEY=
SARVAM_API_KEYS=key1,key2,key3
DATA_DIR=hackathon-data

# The avatar's voice (bulbul:v3 speaker). Sarvam's docs list the names but not
# their gender; these were each called live and confirmed female-sounding:
#   priya, ritu, neha, kavya, shreya, suhani
# Default is priya. bulbul's own default, "shubh", is male.
SARVAM_TTS_SPEAKER=priya
